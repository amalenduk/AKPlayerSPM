# Specify Swift Version (enables all advanced wrapping features)
--swiftversion 5.10

# Maximum line width before wrapping (80 or 100 characters)
--maxwidth 100

# Wrap function parameters on separate lines
--wrapparameters before-first

# Wrap function call arguments on separate lines
--wraparguments before-first

# Put closing parenthesis on its own line
--closingparen balanced

# 4-space indentation
--indent 4

# Clean whitespace
--trimwhitespace always
--linebreaks lf
