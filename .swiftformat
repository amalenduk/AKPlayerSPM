# Swift Version
--swiftversion 6.0

# 100-character line limit (Industry standard for Swift libraries)
--maxwidth 100

# Wrap function parameter lists onto separate lines
--wrapparameters before-first

# Wrap function call arguments onto separate lines
--wraparguments before-first

# Place closing parenthesis on its own line
--closingparen balanced

# Indentation & Linebreaks
--indent 4
--linebreaks lf
--trimwhitespace always

# Clean redundant self and empty lines
--redundanttype inferred
--stripunusedargs always
